<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page.title }} | Albany Cub Scouts Pack 3</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&family=Fredoka:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ url('theme://css/design.css') }}">
</head>
<body>
    {% set h = page.header %}
    <!-- Header -->
    <header class="header">
        <div class="container">
            <div class="header-content">
                <a href="#home" class="logo">
                    <div class="logo-icon"><img src="{{ url('theme://images/pack3-logo.png') }}" alt="Pack 3 Logo"></div>
                    <div class="logo-text">
                        <div class="main">{{ h.brand_main }}</div>
                        <div class="sub">{{ h.brand_sub }}</div>
                    </div>
                </a>
                <nav class="nav-desktop">
                    <a href="#home">Home</a>
                    <a href="#about">About</a>
                    <a href="#organization">Organization</a>
                    <a href="#activities">Activities</a>
                    <a href="#faqs">FAQs</a>
                    <a href="#contact">Contact</a>
                </nav>
            </div>
        </div>
    </header>

    <!-- Hero (fields edited in the Grav Admin "Hero Fields" tab) -->
    <section id="home" class="hero">
        <div class="hero-bg"></div>
        <div class="hero-overlay"></div>
        <div class="container">
            <div class="hero-content">
                <div class="hero-grid">
                    <div>
                        <span class="badge">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                            {{ h.badge }}
                        </span>
                        <h1>{{ h.heading }}</h1>
                        <p class="hero-subtitle">{{ h.subtitle }}</p>
                        <p class="hero-text">{{ h.intro }}</p>
                        <div class="event-card">
                            <h3>{{ h.event_title }}</h3>
                            <div class="event-item">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                {{ h.event_date }}
                            </div>
                            <div class="event-item">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                {{ h.event_time }}
                            </div>
                            <div class="event-item">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                                {{ h.event_location }}
                            </div>
                        </div>
                        <div class="hero-buttons">
                            <a href="#join" class="btn btn-primary btn-large">{{ h.cta_primary }}</a>
                            <a href="#about" class="btn btn-outline btn-large">{{ h.cta_secondary }}</a>
                        </div>
                    </div>
                    <div class="hero-logo">
                        <img src="{{ url('theme://images/pack3-logo.png') }}" alt="Albany Cub Scouts Pack 3 Logo">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Quick Links -->
    <section class="quick-links">
        <a href="#about" class="quick-link-card green">
            <div class="quick-link-bg" style="background-image: url('{{ url('theme://images/card-team.jpg') }}');"></div>
            <div class="quick-link-overlay"></div>
            <div class="quick-link-content">
                <div class="quick-link-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg></div>
                <h3>{{ h.ql1_title }}</h3>
                <p>{{ h.ql1_text }}</p>
                <span class="quick-link-arrow">{{ h.ql_cta }} <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span>
            </div>
        </a>
        <a href="#faqs" class="quick-link-card orange">
            <div class="quick-link-bg" style="background-image: url('{{ url('theme://images/card-registration.jpg') }}');"></div>
            <div class="quick-link-overlay"></div>
            <div class="quick-link-content">
                <div class="quick-link-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg></div>
                <h3>{{ h.ql2_title }}</h3>
                <p>{{ h.ql2_text }}</p>
                <span class="quick-link-arrow">{{ h.ql_cta }} <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span>
            </div>
        </a>
        <a href="#activities" class="quick-link-card gold">
            <div class="quick-link-bg" style="background-image: url('{{ url('theme://images/card-activities.jpg') }}');"></div>
            <div class="quick-link-overlay"></div>
            <div class="quick-link-content">
                <div class="quick-link-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg></div>
                <h3>{{ h.ql3_title }}</h3>
                <p>{{ h.ql3_text }}</p>
                <span class="quick-link-arrow">{{ h.ql_cta }} <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span>
            </div>
        </a>
        <a href="#faqs" class="quick-link-card bark">
            <div class="quick-link-bg" style="background-image: url('{{ url('theme://images/card-faqs.jpg') }}');"></div>
            <div class="quick-link-overlay"></div>
            <div class="quick-link-content">
                <div class="quick-link-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><line x1="12" y1="17" x2="12.01" y2="17"></line></svg></div>
                <h3>{{ h.ql4_title }}</h3>
                <p>{{ h.ql4_text }}</p>
                <span class="quick-link-arrow">{{ h.ql_cta }} <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></span>
            </div>
        </a>
    </section>

    <div style="text-align:center; padding:40px 20px; color:var(--text-light); font-size:14px;">
        — POC excerpt (header · hero · quick links). Hero + event fields are editable in Grav Admin. —
    </div>
</body>
</html>
